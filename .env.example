# Keep API keys and passwords local in .env; never commit real values.
OPENAI_API_KEY=
DATA_GO_KR_SERVICE_KEY=
OPENAI_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small

# Local PostgreSQL used by Docker Compose.
POSTGRES_DB=industrial_safety
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:change-me-locally@localhost:5433/industrial_safety

# Retained for compatibility with the original project scaffold.
DB_URL=
