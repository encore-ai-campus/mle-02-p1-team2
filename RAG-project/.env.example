# data.go.kr SIF API key: 실제 값은 로컬 .env에만 설정하세요.
DATA_GO_KR_SERVICE_KEY=
# RAG 환경변수 예시. 실제 키/비밀번호는 로컬 .env에만 입력하고 커밋하지 않습니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
POSTGRES_DB=industrial_safety
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=postgresql://postgres:<Password>@localhost:5433/<DB명>

